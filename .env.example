# Saytning ommaviy manzili (SEO, Open Graph, sitemap)
NEXT_PUBLIC_APP_URL=http://localhost

# Server Components backend'ga shu manzil orqali murojaat qiladi (Docker tarmog'i ichida)
API_INTERNAL_URL=http://backend:8000

# Ochiq fayllar (kurs muqovasi, ustoz rasmi) manzili
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/sifat-public

# --- Xavfsizlik va monitoring ---
# CSP: storage'dan boshqa qo'shimcha manzillar (CDN), vergul bilan. Server ishlaganda o'qiladi.
CSP_EXTRA_ORIGINS=
# Server (SSR) xatolari uchun Sentry DSN (ixtiyoriy). Brauzer uchun — root .env: SENTRY_DSN_FRONTEND
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
